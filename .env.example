# Copy this file to .env for local development. Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsequeue
POSTGRES_USER=pulsequeue
POSTGRES_PASSWORD=change-me-locally
# Full async DSN used by the application; must stay consistent with the values above.
DATABASE_URL=postgresql+asyncpg://pulsequeue:change-me-locally@localhost:5432/pulsequeue

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Application ---
# Comma-separated list of origins allowed to call the public API. Empty by default (no CORS).
PULSEQUEUE_ALLOWED_ORIGINS=
# Shared secret required on the `X-Admin-Token` header for administrative endpoints
# (dead-letter listing/requeue). Generate a real random value for anything beyond localhost.
PULSEQUEUE_ADMIN_TOKEN=change-me-locally
# Root log level: DEBUG, INFO, WARNING, ERROR.
PULSEQUEUE_LOG_LEVEL=INFO
# Off by default - a local/demo deployment, not an exposed service. Fails open
# (allows the request) if Redis is unreachable; turn on before exposing the API.
PULSEQUEUE_RATE_LIMIT_ENABLED=false
PULSEQUEUE_RATE_LIMIT_PER_MINUTE=120
# Timeouts (Phase 8 - FR9's "set sensible connection/request timeouts").
# DB connect timeout, per-query timeout, and pool-wait timeout.
PULSEQUEUE_DB_CONNECT_TIMEOUT_SECONDS=10.0
PULSEQUEUE_DB_COMMAND_TIMEOUT_SECONDS=30.0
PULSEQUEUE_DB_POOL_TIMEOUT_SECONDS=10.0
# Only bounds establishing the Redis TCP connection - never a blanket
# per-command read timeout, which would break the worker's intentional
# multi-second BLPOP wait.
PULSEQUEUE_REDIS_CONNECT_TIMEOUT_SECONDS=5.0
# Bounds one full HTTP request (503 if exceeded).
PULSEQUEUE_API_REQUEST_TIMEOUT_SECONDS=30.0

# --- Worker ---
PULSEQUEUE_WORKER_CONCURRENCY=4
PULSEQUEUE_WORKER_LEASE_SECONDS=30
PULSEQUEUE_WORKER_POLL_INTERVAL_SECONDS=1.0
# A single handler call is cancelled (treated as a retryable failure) if it
# runs longer than this - protects against a hung handler, not a dead worker
# (that's the lease, PULSEQUEUE_WORKER_LEASE_SECONDS).
PULSEQUEUE_TASK_EXECUTION_TIMEOUT_SECONDS=60.0
# The only directory the processFile demo handler may read from - never a path
# taken from a task's own payload.
PULSEQUEUE_PROCESS_FILE_DIR=var/process_file_inbox

# --- Retry policy defaults (can be overridden per task) ---
PULSEQUEUE_DEFAULT_MAX_ATTEMPTS=4
PULSEQUEUE_RETRY_BASE_DELAY_SECONDS=1.0
PULSEQUEUE_RETRY_MAX_DELAY_SECONDS=60.0
